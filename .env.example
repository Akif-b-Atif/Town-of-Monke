# Required. Bot token: Discord Developer Portal > your application > Bot > Reset Token.
# Keep it secret. Never commit your real .env file (it is listed in .gitignore).
DISCORD_TOKEN=paste_your_token_here

# Optional. Where the SQLite database is stored (default: monke.db in the folder you run the bot from).
# MONKE_DB=monke.db

# Optional. Days to keep chat and command logs of archived games before they are pruned (default: 7).
# The archive zip itself stays in Discord; game snapshots and events are never pruned.
# MONKE_ARCHIVE_DAYS=7

# Optional. Set to 1 to print every role, private message and decision to the console (same as --debug).
# MONKE_DEBUG=0
